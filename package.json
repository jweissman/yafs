{
  "name": "yafs",
  "version": "0.1.0",
  "bin": {
    "yafsd": "./bin/yafsd",
    "yash": "./bin/yash",
    "yafs-mcp": "./bin/yafs-mcp"
  },
  "scripts": {
    "docs": "uvx --with mkdocs-material mkdocs serve",
    "fmt": "bunx prettier src test --write && eslint --fix .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "yafsd": "bun run src/yafsd.ts",
    "yash": "bun run src/yash.ts",
    "mcp": "bun run src/yafs-mcp.ts",
    "validate:m6.3": "zsh script/validate-m6-3.sh",
    "check": "bun test && bun lint && bun typecheck"
  },
  "dependencies": {
    "ohm-js": "^17.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.2",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
